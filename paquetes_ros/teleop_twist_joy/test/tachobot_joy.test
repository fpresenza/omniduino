<launch>
  <node pkg="teleop_twist_joy" name="teleop_twist_joy" type="teleop_node">
    <rosparam>
      axis_linear:
        x: 1
        y: 0 
      scale_linear:
        x: 0.1
        y: 0.1
      scale_linear_turbo:
        x: 1
        y: 1
      axis_angular:
        yaw: 2
      scale_angular:
        yaw: 0.1
      scale_angular_turbo:
        yaw: 1
      enable_button: 11
    </rosparam>
  </node>
</launch>
